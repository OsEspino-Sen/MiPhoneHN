rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Colecciones en español — Mi Phone HN
    match /usuarios/{userId} {
      allow read, write: if request.auth != null;
    }
    match /productos/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /categorias/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /imagenes/{imageKey} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /configuracion/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Metadatos internos (contadores secuenciales, banderas de migración).
    match /_meta/{docId} {
      allow read, write: if request.auth != null;
    }
    // Colección legada: solo autenticados pueden leer/escribir.
    // La migración la drena hacia /usuarios y la deja vacía; el código
    // no crea documentos en "users" (estructura oficial: /usuarios).
    match /users/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
