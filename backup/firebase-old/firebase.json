{
    "hosting":  [
                    {
                        "target":  "client",
                        "public":  "client",
                        "ignore":  [
                                       "firebase.json",
                                       "**/.*",
                                       "**/node_modules/**"
                                   ],
                        "cleanUrls":  true,
                        "headers":  [
                                        {
                                            "headers":  [
                                                            {
                                                                "key":  "Cache-Control",
                                                                "value":  "no-cache"
                                                            }
                                                        ],
                                            "source":  "/**"
                                        }
                                    ]
                    },
                    {
                        "target":  "admin",
                        "public":  "admin",
                        "ignore":  [
                                       "firebase.json",
                                       "**/.*",
                                       "**/node_modules/**"
                                   ],
                        "cleanUrls":  true,
                        "headers":  [
                                        {
                                            "headers":  [
                                                            {
                                                                "key":  "Cache-Control",
                                                                "value":  "no-cache"
                                                            }
                                                        ],
                                            "source":  "/**"
                                        }
                                    ]
                    }
                ],
    "firestore":  {
                      "rules":  "firestore.rules"
                  },
    "storage":  {
                    "rules":  "storage.rules"
                }
}
