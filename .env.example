VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# --- MODO MANTENIMIENTO (separación LOCAL / PRODUCCIÓN) ---
# Entorno de la app: "local" (desarrollo) o "production".
# Determina qué flag se lee/escribe en la tabla 'configuracion':
#   local      -> mantenimiento-local        (NUNCA toca producción)
#   production -> mantenimiento-produccion
# Si falta la variable, se asume "production" (fail-safe).
VITE_APP_ENV=

# Artwork de la página de mantenimiento (opcional).
# Puede ser una URL de Cloudinary o la ruta local /mantenimiento/artwork.svg
# (coloca tu imagen en client/public/mantenimiento/artwork.svg).
VITE_MANTENIMIENTO_ARTWORK_URL=

